# ---------------------------------------------------------------------------
# Sri Cauvery Electronics — environment
# Copy to `.env.local` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma and the pg driver adapter.
# Shared by the storefront, the admin panel and Prisma: one database, one source
# of truth. `npm run dev` starts a local PostgreSQL (PGlite) automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tamizh_electronics?schema=public"

# Optional: separate database used by `prisma migrate dev` for shadow diffing.
# SHADOW_DATABASE_URL=

# 32+ character random string used to sign session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# The same, for the admin panel — and it must be a DIFFERENT random string.
# The two are deliberately separate: if the shop's secret ever leaks, it must
# not be usable to mint an administrator session. Both are mandatory in
# production; outside production each falls back to a fixed development value,
# which is why a missing one only shows up once deployed.
ADMIN_AUTH_SECRET="change-me-to-a-different-long-random-string"

# Public origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storefront contact details shown in the footer / contact page.
NEXT_PUBLIC_SUPPORT_PHONE="+91 98400 00000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@sricauveryelectronics.in"
NEXT_PUBLIC_WHATSAPP="919840000000"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Which gateway the checkout uses for online payments: "mock" | "razorpay".
# "mock" keeps the full order flow working without any gateway account.
PAYMENT_PROVIDER="mock"

# Razorpay — only read on the server. The key id is also exposed to the
# browser through the checkout API response (that one is public by design).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Optional integrations (all no-ops until configured)
# ---------------------------------------------------------------------------
# Transactional email (order confirmations).
# EMAIL_PROVIDER="console"      # console | smtp
# SMTP_URL=
# EMAIL_FROM="Sri Cauvery Electronics <orders@sricauveryelectronics.in>"

# Order SMS notifications.
# SMS_PROVIDER="console"
# SMS_API_KEY=
# SMS_SENDER_ID=

# Product image uploads. "local" writes to public/uploads.
# STORAGE_PROVIDER="local"
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# The admin panel has its own .env.example with the full list. These two are
# the values the STOREFRONT needs in order to reach it.

# Where the panel lives, so the shop can raise a staff alert when an order or a
# return arrives.
ADMIN_SITE_URL="http://localhost:3001"

# Shared secret for those alerts. Must match the panel's INTERNAL_NOTIFY_SECRET
# exactly, and be at least 24 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INTERNAL_NOTIFY_SECRET=""
