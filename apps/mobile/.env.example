# Copy to `.env` (or `.env.local`) in this folder.
#
# The storefront the app talks to. Leave unset in development: the app then
# uses the computer running `npx expo start` on port 3000 — start the
# storefront there with `npm run dev` at the repository root.
#
# Required for preview and store builds, e.g. https://www.example.in
# EXPO_PUBLIC_API_URL=

# Port of the storefront dev server, when it is not 3000.
# EXPO_PUBLIC_DEV_API_PORT=3000
