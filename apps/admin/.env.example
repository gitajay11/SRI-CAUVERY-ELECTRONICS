# =============================================================================
# Tamizh Admin — environment
# =============================================================================
# Copy to .env.local and fill in. Never commit a file containing real values.
#
# Anything not prefixed NEXT_PUBLIC_ stays on the server. There are deliberately
# no NEXT_PUBLIC_ secrets here: if a value must reach the browser, it is not a
# secret, and if it is a secret, it must not reach the browser.

# -- Database ------------------------------------------------------------------
# The SAME database as the storefront. The two applications share one source of
# truth; nothing about products, orders or customers is duplicated between them.
DATABASE_URL="postgresql://user:password@host:5432/tamizh"

# -- Sessions ------------------------------------------------------------------
# A random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Deliberately NOT the storefront's AUTH_SECRET: if a shopper-facing secret ever
# leaks, it must not be usable to mint an administrator session.
ADMIN_AUTH_SECRET=""

# How long a signed-in session lasts, and how long it may sit idle. Both are
# much shorter than a shopper's session — this panel can refund money.
ADMIN_SESSION_HOURS="12"
ADMIN_SESSION_IDLE_HOURS="4"

# -- Where the two applications live -------------------------------------------
# Used for "view in shop" links, and for the storefront to reach this panel.
ADMIN_SITE_URL="https://admin.sricauveryelectronics.in"
NEXT_PUBLIC_SITE_URL="https://sricauveryelectronics.in"

# -- Staff alerts from the storefront ------------------------------------------
# Shared secret the storefront presents when it asks the panel to raise an alert
# (a new order, a return request). Must match the storefront's value exactly.
# At least 24 characters; generate as above.
INTERNAL_NOTIFY_SECRET=""

# -- Web Push (optional) --------------------------------------------------------
# Generate a pair with:  npm run vapid -w @tamizh/admin
# The public key is sent to browsers by design. The private key is a secret;
# rotating it invalidates every existing subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@sricauveryelectronics.in"

# -- Product image uploads ------------------------------------------------------
# "local" writes into the storefront's public folder, which is right when both
# applications share a filesystem. Point STORAGE_LOCAL_DIR at that folder.
# Where product images are stored.
#
#   local  writes into the storefront's public folder. Right for development,
#          impossible once deployed: a serverless filesystem is read-only, and
#          the two apps are separate deployments.
#   blob   Vercel Blob.
#
# Leave this unset and it picks itself: BLOB_READ_WRITE_TOKEN present means
# blob, absent means local. Connecting a Blob store in the Vercel dashboard
# injects that token automatically, so there is usually nothing to set here.
# STORAGE_PROVIDER=

# Injected by Vercel when a Blob store is connected to the project.
# Only set this by hand to test blob uploads from a local machine.
# BLOB_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR="../storefront/public/uploads"
STORAGE_PUBLIC_PREFIX="/uploads"
STORAGE_MAX_BYTES="5242880"
