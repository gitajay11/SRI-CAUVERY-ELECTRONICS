{
  "name": "@tamizh/storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Cauvery Electronics (ஸ்ரீ காவேரி மின்னணுவியல்) — PWA e-commerce storefront for electronics & return gifts.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate --workspace @tamizh/db && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "node --experimental-strip-types scripts/generate-assets.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@tamizh/core": "1.0.0",
    "@tamizh/db": "1.0.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
