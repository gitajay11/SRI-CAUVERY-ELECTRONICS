{
  "name": "@tamizh/db",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations and Prisma client shared by the storefront and admin apps.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./dev-server": "./src/dev-server.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "reset": "node --experimental-strip-types scripts/reset.ts",
    "studio": "prisma studio",
    "start": "node --experimental-strip-types scripts/serve.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "pglite-server": "^0.1.5",
    "prisma": "7.10.0",
    "typescript": "^5.9.3"
  }
}
